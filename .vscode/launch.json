{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Golang Debugger (Tag API): Current File",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/tagging/tag-api",
            "env": {
                "GOFLAGS": "-tags=test"
            },
            "buildFlags": "-tags=test",
        },
        {
            "name": "Golang Debugger (Budget API): Current File",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/budget/budget-api-v2",
            "env": {
                "GOFLAGS": "-tags=test"
            },
            "buildFlags": "-tags=test",
        },
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        }
    ]
}